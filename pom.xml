<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.recreo</groupId>
  <artifactId>recreo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>recreo</name>
  <description>Revision scolaire CP et CM1 - reacteur multi-module (ADR-0001)</description>

  <modules>
    <module>domain</module>
    <module>application</module>
    <module>adapters/adapter-web</module>
    <module>adapters/adapter-content</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <archunit.version>1.5.0</archunit.version>
    <jsoup.version>1.23.1</jsoup.version>
    <nashorn.version>15.7</nashorn.version>
    <maven-toolchains-plugin.version>3.2.0</maven-toolchains-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
  </properties>

  <build>
    <plugins>
      <!-- Le java du PATH n'est pas forcement celui qui doit compiler recreo. Sans cette
           declaration, un poste dont le java du PATH est un JRE echoue au premier module sur
           "No compiler is provided in this environment", message qui ne nomme ni le JDK attendu
           ni l'endroit ou le declarer : trois agents en ont conclu que le JDK 21 etait absent du
           poste et ont mesure sur une autre chaine. Ici, le build s'arrete des la phase validate
           tant qu'aucune toolchain jdk 21 n'est declaree, et le message nomme le type, la version
           et le fichier a renseigner.

           Prerequis de poste : un JDK 21 declare comme toolchain jdk version 21 dans le fichier
           de toolchains de l'utilisateur (CLAUDE.md, section Prerequis de build ;
           outils/mvn-jdk21.sh lance Maven sur ce JDK). En CI, actions/setup-java ecrit lui-meme
           cette toolchain a partir de son entree java-version et de sa distribution.

           Aucun vendor n'est exige : la toolchain d'un poste peut ne pas en declarer, celle de la
           CI en declare un (la distribution installee). Exiger la version seule accepte les deux. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>${maven-toolchains-plugin.version}</version>
        <executions>
          <execution>
            <id>exiger-jdk-21</id>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <version>21</version>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>

      <!-- Une toolchain gouverne le JDK qui compile et qui execute les tests, pas la machine
           virtuelle sur laquelle Maven lui-meme tourne. Or spring-boot-maven-plugin 4.1.0 est
           compile en classe 61 : sur un Maven lance par un JRE 8, il echoue a la toute fin du
           build, au repackage du fat jar, apres plusieurs minutes de tests verts, sur une trace
           "API incompatibility" de quarante lignes qui ne nomme pas le remede. Mesure sur ce
           poste le 2026-08-17 : 483 tests verts, puis cet echec. Cette regle fait dire la meme
           chose en une seconde, a la phase validate, et en une phrase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>exiger-une-jvm-maven-17-ou-plus</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>Maven doit tourner sur un JDK 17 ou plus recent (spring-boot-maven-plugin 4.1.0 est compile en classe 61). Positionner JAVA_HOME sur un JDK 21, ou lancer le build par outils/mvn-jdk21.sh qui le fait a partir de la toolchain jdk 21 declaree.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.recreo</groupId>
        <artifactId>recreo-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.recreo</groupId>
        <artifactId>recreo-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.recreo</groupId>
        <artifactId>recreo-adapter-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.recreo</groupId>
        <artifactId>recreo-adapter-content</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.jsoup</groupId>
        <artifactId>jsoup</artifactId>
        <version>${jsoup.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.nashorn</groupId>
        <artifactId>nashorn-core</artifactId>
        <version>${nashorn.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
